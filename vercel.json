{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/chat/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/whatsapp/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|chat/|whatsapp/).*)",
      "destination": "/frontend/$1"
    }
  ]
}
