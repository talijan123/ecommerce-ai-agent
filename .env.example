# =====================================================================
# LLM Provider Configuration (Groq / OpenAI / Any OpenAI-Compatible API)
# =====================================================================
# Groq Free Tier (Default): Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative / Fallback):
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (WhatsApp Inbound Support & Fast Replies):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# =====================================================================
# Meta WhatsApp Cloud API Configuration
# =====================================================================
# Meta Developers Portal (https://developers.facebook.com)
WHATSAPP_TOKEN=EAAB...your_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=autocommerce_wa_verify_token_123
WHATSAPP_API_VERSION=v21.0

# =====================================================================
# Database Configuration (PostgreSQL / Supabase / SQLite)
# =====================================================================
# Local SQLite (Default):
DATABASE_URL=sqlite:///./ecommerce.db
# Supabase / PostgreSQL (Production):
# DATABASE_URL=postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres

# =====================================================================
# Abandoned Cart Background Worker & Recovery Settings
# =====================================================================
RECOVERY_CRON_INTERVAL_MINUTES=15
RECOVERY_ABANDON_THRESHOLD_MINUTES=30
ENABLE_RECOVERY_SCHEDULER=True

# =====================================================================
# Application Settings
# =====================================================================
PROJECT_NAME="Autonomous E-Commerce AI Agent API"
API_V1_STR=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=["*"]
